# انسخ هذا الملف إلى .env عند النشر (أو اضبط المتغيرات في بيئة الاستضافة)
PORT=3000

# حد حجم الملف الواحد بالبايت — حماية من استهلاك ذاكرة المتصفح (DoS)
# 2GB افتراضياً
MAX_FILE_SIZE=2147483648

# أقصى عدد أجهزة في الغرفة الواحدة (2–8، الجلسة الثنائية هي الافتراضي)
MAX_PEERS=2

# سقف عدد الغرف المتزامنة — حماية من استهلاك ذاكرة الخادم
MAX_ROOMS=1000

# عمر الغرفة الأقصى بالمللي ثانية (افتراضي ساعتان) ثم تُنظَّف تلقائياً
ROOM_TTL_MS=7200000

# خوادم ICE — STUN مجاني افتراضياً، وأضف TURN للخصوصية وإخفاء IP
STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:your-turn.example.com:3478
# TURN_USERNAME=
# TURN_PASSWORD=

# عند النشر خلف وكيل عكسي (Nginx/Caddy/Cloudflare) فعّل هذا لقراءة IP الحقيقي
# TRUST_PROXY=1

# قائمة أصول مسموحة مفصولة بفواصل (اتركها فارغة للسماح بنفس المضيف فقط)
# ALLOWED_ORIGINS=https://share.example.com

# للإنتاج: شغّل خلف HTTPS (WSS) عبر Nginx/Caddy/Cloudflare — لا تستخدم HTTP على الإنترنت
NODE_ENV=production
